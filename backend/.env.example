# SafeSphere AI Enterprise Backend Environment Configuration

# Server Settings
PROJECT_NAME="SafeSphere AI Enterprise Backend"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"
API_V1_STR="/api/v1"

# 1. Security & JWT Settings
JWT_SECRET="safesphere_super_secret_jwt_key_change_in_production"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=1440 # 24 Hours

# 2. Supabase Auth Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# 3. Firebase Database & Push Notifications
FIREBASE_PROJECT_ID="safesphere-ai-demo"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@safesphere-ai-demo.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL="https://safesphere-ai-demo-default-rtdb.firebaseio.com"
FCM_SERVER_KEY="your-fcm-server-key"

# 4. External AI, Maps & Places APIs
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
GOOGLE_PLACES_API_KEY="your-google-places-api-key"
OPENAI_API_KEY="your-openai-api-key"

# 5. Risk Engine Configuration Thresholds
RISK_THRESHOLD_WARNING=30.0
RISK_THRESHOLD_DANGER=60.0
RISK_THRESHOLD_CRITICAL=75.0
GUARDIAN_AUTO_ALERT_TIMEOUT_SECONDS=15
